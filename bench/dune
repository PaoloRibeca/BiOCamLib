; Only the linking is set here, static in the release-static profile: the optimisation level
; is set once, for everything built, in dune-workspace.
(env
 (release-static
  (ocamlopt_flags (:standard -ccopt -static))))

; Measurements rather than checks.  Kept out of test/, which is the suite and
; is meant to stay quick, and out of bin/, which is what gets installed: this is
; built on demand and run by hand.
(executables
 (names Bench_Mpileup Bench_TransitiveClosure Bench_LevenshteinBall)
 (modules Bench_Mpileup Bench_TransitiveClosure Bench_LevenshteinBall)
 (libraries str unix BiOCamLib))
