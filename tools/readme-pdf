#!/usr/bin/env bash
#
# BiOCamLib/tools/readme-pdf -- render a repository's README.md to README.pdf.
#
#   readme-pdf --root <dir> --title <Title>
#
# Markdown -> self-contained HTML (pandoc, GitHub-flavoured, images and CSS
# embedded) -> PDF (headless Chrome/Chromium, the same engine GitHub's "print to
# PDF" uses).  Needs pandoc and google-chrome/chromium.
#
# Two stylesheets are passed, in order: this directory's README.css, which is
# the house look and the print machinery every repository shares, and then the
# repository's own README.css if it has one -- which is where a per-figure rule
# belongs, since only that repository has the figure.  A repository with no
# figures to split needs no stylesheet of its own at all.
#
# Note what is deliberately NOT here: measuring the width a figure should be
# included at.  That is tools/figscale, run by hand when a figure is added or
# changed, because the width it computes is then baked into README.md and this
# script only renders what is already there.

set -e

SELF="$(basename "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ROOT="" TITLE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --root)  ROOT="${2:-}";  shift 2 ;;
    --title) TITLE="${2:-}"; shift 2 ;;
    *) echo "$SELF: unexpected argument '$1'" >&2
       echo "Usage: $SELF --root <dir> --title <Title>" >&2; exit 1 ;;
  esac
done
[[ -n "$ROOT" && -n "$TITLE" ]] \
  || { echo "Usage: $SELF --root <dir> --title <Title>" >&2; exit 1; }

cd "$ROOT"
[[ -f README.md ]] || { echo "$SELF: no README.md in $ROOT" >&2; exit 1; }
command -v pandoc >/dev/null 2>&1 || { echo "$SELF: pandoc not found" >&2; exit 1; }
CHROME=""
for c in google-chrome google-chrome-stable chromium chromium-browser; do
  if command -v "$c" >/dev/null 2>&1; then CHROME="$c"; break; fi
done
[[ -n "$CHROME" ]] || { echo "$SELF: no google-chrome/chromium found" >&2; exit 1; }

HTML="$(mktemp --suffix=.html)"
# Private profile dir so this Chrome never blocks on the default-profile
# singleton lock held by an unrelated Chrome already running on the host.
UDD="$(mktemp -d)"
# Render to a temp PDF; only move it into place once it IS a valid PDF, so that
# a Chrome crash never leaves a stale README.pdf looking like success.
PDF="$(mktemp --suffix=.pdf)"
LOG="$(mktemp)"
trap 'rm -rf "$HTML" "$UDD" "$PDF" "$LOG"' EXIT

# --embed-resources (pandoc >= 2.19) supersedes the older --self-contained; use
# whichever this pandoc advertises so the build also works on older installs.
EMBED=--embed-resources
pandoc --help 2>/dev/null | grep -q -- --embed-resources || EMBED=--self-contained

# pandoc resolves a stylesheet's url() relative to that stylesheet's directory,
# so a per-figure background image named 'docs/FIG.png' has to be reached from a
# README.css sitting in the repository root -- which is exactly where a
# repository's own stylesheet is.  The shared one carries no url() for that
# reason.
CSS=(--css "$HERE/README.css")
[[ -f README.css ]] && CSS+=(--css README.css)

pandoc README.md -f gfm -t html5 --standalone "$EMBED" \
       "${CSS[@]}" --metadata title="$TITLE" -o "$HTML"

# --disable-background-networking is essential: the GCM/SSL phone-home Chrome
# otherwise attempts stalls -- and on some builds crashes (dangling raw_ptr) --
# the headless render of a large image-heavy page.  The rest is headless hygiene
# so the render is fully self-contained.
if "$CHROME" --headless=new --no-sandbox --disable-gpu \
     --disable-dev-shm-usage --disable-background-networking \
     --disable-default-apps --disable-extensions --disable-sync \
     --disable-component-update --no-first-run --metrics-recording-only \
     --user-data-dir="$UDD" --no-pdf-header-footer \
     --print-to-pdf="$PDF" "$HTML" 2>"$LOG" \
   && [[ -s "$PDF" ]] && [[ "$(head -c4 "$PDF")" == "%PDF" ]]; then
  mv "$PDF" README.pdf
  echo "$SELF: wrote README.pdf"
else
  echo "$SELF: README.pdf FAILED — pandoc or headless Chrome error:" >&2
  sed 's/^/    /' "$LOG" >&2
  exit 1
fi
