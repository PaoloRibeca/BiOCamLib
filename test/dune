(env
 (dev
  (ocamlopt_flags (:standard -g)))
 (dev-static
  (ocamlopt_flags (:standard -g -ccopt -static)))
 (release
  (ocamlopt_flags (:standard -O3 -ccopt -O3)))
 (release-static
  (ocamlopt_flags (:standard -O3 -ccopt -O3 -ccopt -static))))

; The assertion suite.  Tests is the entry point; the harness itself is now
; BiOCamLib.Testing, and every Tests_<Area> module is one area's checks.  Not
; installed: it is run from the build tree by BUILD.
(executables
 (names Tests)
 (modules Tests Tests_Annotations Tests_Sequences Tests_Tools Tests_Numbers Tests_Trees
          Tests_Better Tests_KMers Tests_Matrix Tests_Files Tests_Consensus Tests_Processes Tests_Mpileup)
 (libraries str unix BiOCamLib))
