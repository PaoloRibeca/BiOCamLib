(menhir
 (modules Trees_Parse Annotations_Parse)
 (flags --dump --explain --automaton-graph --cmly))
(ocamllex Trees_Lex Annotations_Lex)

; Everything below the thirteen toplevel modules is private: the two [_Base]
; modules, the [Annotations] scaffolding, the five per-format modules, and the
; lexers and parsers.  Sealing a module that something re-exports takes one
; precaution, because an unconstrained [include M] -- or a [module X = M.Y]
; alias -- re-exports M's contents as aliases INTO M, and an alias into a
; private module does not resolve; the compiler then says that some module "is
; an alias for BiOCamLib__M.X, which is missing".  Constraining the include
; copies the signature instead of aliasing it, which closes the door behind the
; module.  Where the signature is worth writing down -- the five format modules,
; whose surface is four lines and is checked against what they declare -- it is
; written down; where it is only scaffolding, [include (M: module type of M)]
; says "copy, do not alias" without repeating anything.
;
; The distinction is between an alias and a manifest, and only the first is
; fatal.  Annotations.ml is itself sealed, in the house [include (struct ... end:
; sig ... end)] form, and its signature spells types as [Annotations_Base.X.t =
; ...]; such an equation resolves for a consumer even though the module it names
; is private.  Note that this works only from inside lib/, where the private
; modules can be named at all: re-declaring a component from outside -- [module
; X: module type of Annotations_Common.X] -- mints a fresh opaque type anchored
; in a module the consumer cannot see, and fails.

(library
 (libraries zarith)
 (public_name BiOCamLib)
 (name BiOCamLib)
 (private_modules
   Annotations_Base
   Annotations_Common
   Annotations_GFF3
   Annotations_GTF
   Annotations_GenBank
   Annotations_Tabular
   Annotations_Tbl
   Annotations_Lex
   Annotations_Parse
   Trees_Base
   Trees_Lex
   Trees_Parse))
